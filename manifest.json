{
  "manifest_version": 3,
  "name": "QR Platba Generator česko",
  "version": "1.0",
  "description": "Vygeneruje český platební QR kód z označeného textu na faktuře.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  }
}
